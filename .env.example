# ============================================================
# FinSight IDX — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Anthropic Claude API ---
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# --- Claude Model Settings ---
# Recommended: claude-sonnet-4-20250514 (balance cost/quality)
# Alternative: claude-opus-4-20250514 (highest quality, higher cost)
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0.2

# --- Embedding Model ---
# Local HuggingFace model (no API key needed)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- ChromaDB Vector Store ---
CHROMA_PERSIST_DIR=./data/vectorstore
CHROMA_COLLECTION_NAME=finsight_documents

# --- Data Paths ---
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed

# --- MCP Server ---
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_LOG_LEVEL=INFO

# --- Application Settings ---
LOG_LEVEL=INFO
ENV=development
