# ============================================================
# FinSight IDX — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# Keep comments on their own lines: `docker run --env-file` does not strip inline comments.
# ============================================================

# --- Anthropic Claude API ---
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# --- Claude Model Settings ---
# Model IDs change over time. Pick a current one from
# https://docs.claude.com/en/docs/about-claude/models and verify it with:
#   python scripts/check_model.py
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0.2

# --- Vector store ---
# The embedding model is fixed in code (src/rag/indexer.py) and recorded in
# data/vectorstore/index_manifest.json; changing it requires a full re-index.
# used by the MCP server
CHROMA_PERSIST_DIR=./data/vectorstore
# used by app.py
VECTORSTORE_DIR=./data/vectorstore
# 1 in deployment: refuse an index without a valid manifest
FINSIGHT_STRICT_INDEX=0

# --- Retrieval (pick from the golden-set evaluation) ---
# chunks sent to the model per question (10 = best context hit in the README table)
RAG_TOP_K=10
# hybrid (embeddings + BM25) or bm25 (best on the golden set)
RETRIEVAL_MODE=bm25

# --- Indexing ---
# auto | off | required (needs tesseract)
FINSIGHT_OCR=auto
OCR_LANG=ind+eng

# --- Serving guardrails (app.py) ---
MAX_QUESTION_CHARS=500
# per visitor
RATE_LIMIT_PER_MINUTE=5
# all visitors together
RATE_LIMIT_GLOBAL_PER_MINUTE=20
# estimated USD per UTC day before the demo stops calling the API (0 = off)
DAILY_BUDGET_USD=0.30
# agent history kept per session
MAX_AGENT_MESSAGES=20
QUEUE_MAX_SIZE=20

# --- Telemetry ---
QUERY_LOG_PATH=logs/queries.jsonl
# 1 stores question text in the log (debug only)
LOG_QUESTION_TEXT=0
# price used for cost estimates; match your model
CLAUDE_INPUT_USD_PER_MTOK=3
CLAUDE_OUTPUT_USD_PER_MTOK=15

# --- Data Paths ---
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed

# --- MCP Server ---
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_LOG_LEVEL=INFO

# --- Application Settings ---
LOG_LEVEL=INFO
ENV=development
