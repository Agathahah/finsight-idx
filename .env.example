# ============================================================
# FinSight IDX — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Anthropic Claude API ---
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# --- Claude Model Settings ---
# Model IDs change over time. Pick a current one from
# https://docs.claude.com/en/docs/about-claude/models and verify it with:
#   python scripts/check_model.py
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0.2

# --- Vector store ---
# The embedding model is fixed in code (src/rag/indexer.py) and recorded in
# data/vectorstore/index_manifest.json; changing it requires a full re-index.
CHROMA_PERSIST_DIR=./data/vectorstore     # used by the MCP server
VECTORSTORE_DIR=./data/vectorstore        # used by app.py
FINSIGHT_STRICT_INDEX=0                   # 1 in deployment: refuse an index without a valid manifest

# --- Indexing ---
FINSIGHT_OCR=auto                         # auto | off | required (needs tesseract)
OCR_LANG=ind+eng

# --- Serving guardrails (app.py) ---
MAX_QUESTION_CHARS=500
RATE_LIMIT_PER_MINUTE=5                   # per visitor
RATE_LIMIT_GLOBAL_PER_MINUTE=60           # all visitors together: caps API spend
MAX_AGENT_MESSAGES=20                     # agent history kept per session
QUEUE_MAX_SIZE=20

# --- Telemetry ---
QUERY_LOG_PATH=logs/queries.jsonl
LOG_QUESTION_TEXT=0                       # 1 stores question text in the log (debug only)
CLAUDE_INPUT_USD_PER_MTOK=3               # price used for cost estimates; match your model
CLAUDE_OUTPUT_USD_PER_MTOK=15

# --- Data Paths ---
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed

# --- MCP Server ---
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_LOG_LEVEL=INFO

# --- Application Settings ---
LOG_LEVEL=INFO
ENV=development
