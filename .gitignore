# ============================================================
# FinSight IDX — .gitignore
# ============================================================

# Environment & secrets
.env
.env.local
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Data — raw PDFs and processed files (too large for git)
data/raw/
data/processed/
data/vectorstore/

# Model cache (HuggingFace downloads)
.cache/
models/

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Type checking
.mypy_cache/

# Linting
.ruff_cache/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Logs
*.log
logs/
